{
  "name": "kavach-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:site": "pnpm --filter @kavach/site dev",
    "dev:app": "pnpm --filter @kavach/app dev",
    "dev:admin": "pnpm --filter @kavach/admin dev",
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" build",
    "build:site": "pnpm --filter @kavach/site build",
    "theme-audit": "node scripts/theme-audit.mjs"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0"
  }
}
