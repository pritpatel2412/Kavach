# Copy to .env (git-ignored). NEVER commit real keys.
GNANI_API_KEY=                 # app.gnani.ai/voice -> API keys (3 free keys). Sent as X-API-Key-ID / x-api-key-id
KAVACH_MOCK_STT=1              # 1 = offline scripted transcripts (zero credits). Set 0 for live Prisma.
MOCK_SEGMENT_INTERVAL_S=4
DEFAULT_LANG=hi-IN             # hi-IN | en-IN (Hinglish -> Latin script) | ta-IN | te-IN ...
STT_VAD_THRESHOLD=0.7          # telephony preset; tune in Phase 1/6
STT_MIN_SILENCE_MS=500
STT_MIN_SPEECH_MS=200
ECHO_GATE_TAIL_S=0.4
TELEGRAM_BOT_TOKEN=            # optional guardian alerts (Phase 4)
TELEGRAM_CHAT_ID=
LLM_PROVIDER=                  # optional Phase 6 second-opinion layer (groq|anthropic|none)
LLM_API_KEY=
